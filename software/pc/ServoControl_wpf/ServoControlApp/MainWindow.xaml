<Window x:Class="ServoControlApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ServoControlApp"
        Title="Servo Control" Height="600" Width="800">
    <DockPanel>
        <!-- 工具栏 -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">
            <Label Content="IP Address:" Margin="5"/>
            <TextBox x:Name="txtIpAddress" Margin="5" Width="120" Text="192.168.0.1"/>
            <Label Content="Port:" Margin="5"/>
            <TextBox x:Name="txtPort" Margin="5" Width="60" Text="1234"/>
            <Button Content="Connect" Margin="5" Click="Connect_Click"/>
        </StackPanel>

        <!-- 主体区域 -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- 左边的 Servo 控件组 -->
            <GroupBox Grid.Row="0" Grid.Column="0" Header="Left">
                <ItemsControl Grid.Column="0" ItemsSource="{Binding LeftServos}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="4" Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <local:ServoControl Side="LEFT" Order="{Binding Order}" Value="{Binding Value}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </GroupBox>
            

            <!-- 右边的 Servo 控件组 -->
            <GroupBox Grid.Row="0" Grid.Column="1" Header="Right">
                <ItemsControl Grid.Column="1" ItemsSource="{Binding RightServos}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="4" Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <local:ServoControl Side="RIGHT" Order="{Binding Order}" Value="{Binding Value}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </GroupBox>
            <GroupBox Grid.Row="1" Grid.ColumnSpan="2" Grid.Column="0" Header="log" MouseDoubleClick="Control_OnMouseDoubleClick">
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding LogEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock 
                                    FontFamily="Consolas" 
                                    FontSize="12" 
                                    Text="{Binding Message}" 
                                    Foreground="{Binding MessageColor}" 
                                    Margin="5"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

            </GroupBox>
        </Grid>
    </DockPanel>
</Window>