<UserControl x:Class="ServoControlApp.ServoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ServoControlApp">
    <Grid Margin="5">
        <!-- 使用GroupBox替代Label -->
        <GroupBox Grid.Column="0"
                  Header="{Binding Order, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ServoControl}}}"
                  Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 滑块 -->
                <Slider Grid.Row="0"
                        VerticalAlignment="Center"
                        Name="Slider"
                        Margin="5"
                        Minimum="125"
                        Maximum="575"
                        Value="350"
                        TickFrequency="1"
                        TickPlacement="BottomRight"
                        ValueChanged="Slider_ValueChanged"
                        PreviewMouseLeftButtonUp="UIElement_OnPreviewMouseLeftButtonUp"/>

                <!-- 当前值 -->
                <TextBlock Grid.Row="1"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="5"
                           Text="{Binding Value, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ServoControl}}}"
                           FontWeight="Bold"
                           />
                <Button Grid.Row="2" Click="ButtonBase_OnClick" />
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>