<Window x:Class="ESP32MiniServo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ESP32MiniServo"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <DockPanel Grid.Row="0" Margin="5">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top">
                <TextBlock Text="IP:" Margin="5,0" VerticalAlignment="Center" />
                <TextBox x:Name="txtIP" Width="120" Margin="5,0" Text="127.0.0.1" />
                <TextBlock Text="端口:" Margin="5,0" VerticalAlignment="Center" />
                <TextBox x:Name="txtPort" Width="80" Margin="5,0" Text="1234" />
                <Button x:Name="BtnConnect" Content="连接" Margin="5,0" Padding="10,3" Click="BtnConnect_Click" />
                <Button x:Name="BtnGenerate" Content="生成" Margin="5,0" Padding="10,3" Click="BtnGenerate_Click" />
            </StackPanel>
        </DockPanel>

        <!-- 主体界面 -->
        <Grid Grid.Row="1" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="400" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 主体上部分 -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左侧3x3网格 -->
                <GroupBox Grid.Column="0" Header="Left">
                    <Grid Grid.Column="0" Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <GroupBox Grid.Row="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <local:CustomControl Grid.Row="0" Grid.Column="0" Index="0" Side="Left" Offset="0" />
                                <local:CustomControl Grid.Row="0" Grid.Column="1" Index="1" Side="Left" Offset="0" />
                                <local:CustomControl Grid.Row="0" Grid.Column="2" Index="2" Side="Left" Offset="0" />
                            </Grid>
                        </GroupBox>
                        <GroupBox Grid.Row="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <local:CustomControl Grid.Row="0" Grid.Column="0" Index="3" Side="Left" Offset="0" />
                                <local:CustomControl Grid.Row="0" Grid.Column="1" Index="4" Side="Left" Offset="0" />
                                <local:CustomControl Grid.Row="0" Grid.Column="2" Index="5" Side="Left" Offset="0" />
                            </Grid>
                        </GroupBox>
                        <GroupBox Grid.Row="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <local:CustomControl Grid.Row="0" Grid.Column="0" Index="6" Side="Left" Offset="0" />
                                <local:CustomControl Grid.Row="0" Grid.Column="1" Index="7" Side="Left" Offset="0" />
                                <local:CustomControl Grid.Row="0" Grid.Column="2" Index="8" Side="Left" Offset="0" />
                            </Grid>
                        </GroupBox>
                    </Grid>

                </GroupBox>

                <!-- 右侧3x3网格 -->
                <GroupBox Grid.Column="2" Header="Right">
                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <GroupBox Grid.Row="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <local:CustomControl Grid.Column="0" Index="8" Side="Right" Offset="0" />
                                <local:CustomControl Grid.Column="1" Index="7" Side="Right" Offset="0" />
                                <local:CustomControl Grid.Column="2" Index="6" Side="Right" Offset="0" />
                                
                            </Grid>

                        </GroupBox>
                        <GroupBox Grid.Row="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <local:CustomControl Grid.Column="0" Index="5" Side="Right" Offset="0" />
                                <local:CustomControl Grid.Column="1" Index="4" Side="Right" Offset="0" />
                                <local:CustomControl Grid.Column="2" Index="3" Side="Right" Offset="0" />
                            </Grid>

                        </GroupBox>
                        <GroupBox Grid.Row="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <local:CustomControl Grid.Column="0" Index="2" Side="Right" />
                                <local:CustomControl Grid.Column="1" Index="1" Side="Right" />
                                <local:CustomControl Grid.Column="2" Index="0" Side="Right" />
                            </Grid>

                        </GroupBox>


                    </Grid>
                </GroupBox>

            </Grid>

            <!-- 主体下半部分 - 日志记录 -->
            <ListBox x:Name="lstLog" Grid.Row="1" Margin="5" BorderBrush="Gray" BorderThickness="1" Background="White">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="5" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="TextWrapping" Value="Wrap" />
                    </Style>
                </ListBox.Resources>
            </ListBox>
        </Grid>
    </Grid>
</Window>