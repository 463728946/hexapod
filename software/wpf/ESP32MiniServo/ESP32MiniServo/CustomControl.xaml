<UserControl x:Class="ESP32MiniServo.CustomControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ESP32MiniServo"
             mc:Ignorable="d"
             d:DesignHeight="80" d:DesignWidth="200">
    <Grid Margin="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 序号显示 -->
        <TextBlock x:Name="txtIndex" Grid.Row="0" Text="{Binding Index}" HorizontalAlignment="Center"
                   VerticalAlignment="Center" FontWeight="Bold" />

        <!-- 按钮和输入框 -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Grid.Row="0" Content="MIN" Margin="2" Click="BtnMIN_Click" />
            <Button Grid.Column="1" Grid.Row="0" Content="MID" Margin="2" Click="BtnMID_Click" />
            <Button Grid.Column="2" Grid.Row="0" Content="MAX" Margin="2" Click="BtnMAX_Click" />
            <TextBox Grid.Column="0" Grid.Row="1" x:Name="TxtOffset" Grid.ColumnSpan="3" Margin="2"
                     VerticalAlignment="Bottom" HorizontalContentAlignment="Center"
                     Text="{Binding Offset, Mode=TwoWay}" TextChanged="TxtOffset_TextChanged" />
        </Grid>
    </Grid>
</UserControl>